# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to GitHub.

NODE_ENV=development
PORT=5000

# MongoDB connection string (local MongoDB or MongoDB Atlas)
# Atlas looks like: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shopsphere?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shopsphere

# Long random text used to sign login tokens (at least 32 characters in production)
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Website address(es) allowed to call this API, comma separated, no trailing slash.
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Only used by "npm run seed" to create the first admin account
SEED_ADMIN_NAME=Shop Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123
