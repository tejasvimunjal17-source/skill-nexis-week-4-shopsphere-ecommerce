# Copy to ".env" for local work. Vite only exposes variables that start with VITE_.
# Local development (uses the proxy in vite.config.js, backend on port 5000):
VITE_API_URL=/api
# On Vercel set this to your Render backend, for example:
# VITE_API_URL=https://your-backend.onrender.com/api

# Currency code used to show prices (USD, INR, EUR ...)
VITE_CURRENCY=USD
